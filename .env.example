# Groq API (LLM Provider)
GROQ_API_KEY=your_groq_api_key_here

# Optional: comma-separated allowlist for the client-selectable `model` field.
# Only plain chat models without built-in tools should be listed (agentic
# models such as groq/compound* are excluded to prevent provider-side fetching).
# GROQ_ALLOWED_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile

# Blockchain Configuration (Base Sepolia)
RPC_URL=https://sepolia.base.org
CONTRACT_ADDRESS=0x03Ce9c7C6441Bd274DC462d1c682F976ee695526
PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# Optional: enables DELETE /agent/logs/{task_id} when set (request must send
# matching X-Admin-Key header). If unset, log deletion is disabled.
ADMIN_API_KEY=

# Optional: per-IP rate limits (requests per minute)
RATE_LIMIT_RUN_PER_MINUTE=10
RATE_LIMIT_CLASSIFY_PER_MINUTE=30
RATE_LIMIT_FILTER_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=60
